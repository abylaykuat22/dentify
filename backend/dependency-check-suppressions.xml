<?xml version="1.0" encoding="UTF-8"?>
<!--
  Согласованный allowlist OWASP dependency-check (PLT-06: сборка падает на уязвимости с CVSS 7 и выше, если её нет здесь).
  Запускается ../verify.ps1 -Scan (или ../verify.sh с ключом scan), отчёт — target/dependency-check-report.html.

  Каждое исключение — только осознанное и временное:
  - <notes>: почему не касается нас (код не вызывается, ложное срабатывание по CPE) или чем закрыто, кто согласовал;
  - until="ГГГГ-ММ-ДДZ": срок пересмотра; после него исключение перестаёт действовать и проверка снова краснеет;
  - точечно: packageUrl конкретной версии и cve/vulnerabilityName, а не весь пакет.

  Пример:
  <suppress until="2026-12-31Z">
    <notes>CVE-2026-00000: уязвим только режим X, мы его не включаем (решение владельца 2026-10-01). Обновить до 1.2.4.</notes>
    <packageUrl regex="true">^pkg:maven/org\.example/lib@1\.2\.3$</packageUrl>
    <cve>CVE-2026-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
